# Owner: docs/architecture-contract.md
# Scope: static import graph only; dynamic loaders require targeted contracts.
[importlinter]
root_packages =
    xic_extractor
    gui
    scripts
    tools
    xic_inspector
exclude_type_checking_imports = False

[importlinter:contract:domain-no-outer-layer]
name = Domain does not import outer layers
type = forbidden
source_modules =
    xic_extractor
forbidden_modules =
    gui
    scripts
    tools
    xic_inspector
allow_indirect_imports = False

[importlinter:contract:peak-detection-stays-inner]
name = Peak detection stays inner
type = forbidden
source_modules =
    xic_extractor.peak_detection
forbidden_modules =
    xic_extractor.alignment
    xic_extractor.diagnostics
    xic_extractor.discovery
    xic_extractor.extraction
    xic_extractor.output
    xic_extractor.raw_reader
allow_indirect_imports = False
ignore_imports =
    # Migration debt owner: #117 R6 / #122; exact current boundary edges that reach RAW-coupled semantics.
    xic_extractor.peak_detection.candidate_selection -> xic_extractor.decision_policy
    xic_extractor.peak_detection.decision_policy -> xic_extractor.decision_policy
    xic_extractor.peak_detection.evidence_facts -> xic_extractor.evidence_semantics
    xic_extractor.peak_detection.hypotheses -> xic_extractor.evidence_semantics
    xic_extractor.peak_detection.hypotheses -> xic_extractor.neutral_loss
    xic_extractor.peak_detection.model_selection -> xic_extractor.decision_policy
    xic_extractor.peak_detection.model_selection -> xic_extractor.evidence_semantics
    xic_extractor.peak_detection.selection_decision -> xic_extractor.evidence_semantics
unmatched_ignore_imports_alerting = error

[importlinter:contract:configuration-stays-inner]
name = Configuration stays inner
type = forbidden
source_modules =
    xic_extractor.configuration
forbidden_modules =
    xic_extractor.alignment
    xic_extractor.diagnostics
    xic_extractor.discovery
    xic_extractor.extraction
    xic_extractor.output
    xic_extractor.raw_reader
allow_indirect_imports = False

[importlinter:contract:output-does-not-read-raw]
name = Output does not read raw
type = forbidden
source_modules =
    xic_extractor.output
forbidden_modules =
    xic_extractor.raw_reader
allow_indirect_imports = False
ignore_imports =
    # Migration debt owner: #117 R6 / #122; exact current projection edges that reach RAW-coupled owners.
    xic_extractor.output.csv_writers -> xic_extractor.neutral_loss
    xic_extractor.output.csv_writers -> xic_extractor.signal_processing
    xic_extractor.output.messages -> xic_extractor.neutral_loss
    xic_extractor.output.messages -> xic_extractor.signal_processing
unmatched_ignore_imports_alerting = error

[importlinter:contract:output-does-not-import-orchestration]
name = Output does not import orchestration
type = forbidden
source_modules =
    xic_extractor.output
forbidden_modules =
    xic_extractor.extraction
    xic_extractor.extractor
allow_indirect_imports = False
