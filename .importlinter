# Owner: docs/architecture-contract.md
# Scope: static import graph only; dynamic loaders require targeted contracts.
[importlinter]
root_packages =
    xic_extractor
    scripts
    tools
    xic_inspector
    xic_workbench
exclude_type_checking_imports = False

[importlinter:contract:domain-no-outer-layer]
name = Domain does not import outer layers
type = forbidden
source_modules =
    xic_extractor
forbidden_modules =
    scripts
    tools
    xic_inspector
    xic_workbench
allow_indirect_imports = False

[importlinter:contract:peak-detection-stays-inner]
name = Peak detection stays inner
type = forbidden
source_modules =
    xic_extractor.peak_detection
forbidden_modules =
    xic_extractor.alignment
    xic_extractor.diagnostics
    xic_extractor.discovery
    xic_extractor.extraction
    xic_extractor.untargeted_execution
    xic_extractor.output
    xic_extractor.raw_reader
allow_indirect_imports = False

[importlinter:contract:configuration-stays-inner]
name = Configuration stays inner
type = forbidden
source_modules =
    xic_extractor.configuration
forbidden_modules =
    xic_extractor.alignment
    xic_extractor.diagnostics
    xic_extractor.discovery
    xic_extractor.extraction
    xic_extractor.untargeted_execution
    xic_extractor.output
    xic_extractor.peak_detection
    xic_extractor.precursor_evidence
    xic_extractor.raw_reader
allow_indirect_imports = False

[importlinter:contract:output-does-not-read-raw]
name = Output stays outside RAW and orchestration
type = forbidden
source_modules =
    xic_extractor.output
forbidden_modules =
    xic_extractor.applications
    xic_extractor.extraction
    xic_extractor.untargeted_execution
    xic_extractor.extractor
    xic_extractor.raw_reader
allow_indirect_imports = False

[importlinter:contract:inner-layers-do-not-import-diagnostics]
name = Inner layers do not import diagnostics
type = forbidden
source_modules =
    xic_extractor.acquisition
    xic_extractor.alignment
    xic_extractor.configuration
    xic_extractor.discovery
    xic_extractor.evidence
    xic_extractor.execution
    xic_extractor.extraction
    xic_extractor.untargeted_execution
    xic_extractor.output
    xic_extractor.peak_detection
forbidden_modules =
    xic_extractor.diagnostics
allow_indirect_imports = False

[importlinter:contract:inner-layers-do-not-import-applications]
name = Inner layers do not import applications
type = forbidden
source_modules =
    xic_extractor.acquisition
    xic_extractor.alignment
    xic_extractor.configuration
    xic_extractor.diagnostics
    xic_extractor.discovery
    xic_extractor.evidence
    xic_extractor.execution
    xic_extractor.extraction
    xic_extractor.untargeted_execution
    xic_extractor.output
    xic_extractor.peak_detection
forbidden_modules =
    xic_extractor.applications
allow_indirect_imports = False

[importlinter:contract:targeted-untargeted-independent]
name = Targeted extraction and Untargeted execution are independent
type = independence
modules =
    xic_extractor.extraction
    xic_extractor.untargeted_execution

[importlinter:contract:main-chain-layers]
name = Main processing chain layers
type = layers
layers =
    xic_extractor.applications
    xic_extractor.untargeted_execution | xic_extractor.extraction
    xic_extractor.alignment
    xic_extractor.discovery
    xic_extractor.peak_detection

[importlinter:contract:acquisition-stays-inner]
name = Acquisition stays inner
type = forbidden
source_modules =
    xic_extractor.acquisition
forbidden_modules =
    xic_extractor.alignment
    xic_extractor.applications
    xic_extractor.discovery
    xic_extractor.extraction
    xic_extractor.untargeted_execution
    xic_extractor.output
allow_indirect_imports = False

[importlinter:contract:sample-metadata-no-instrument-qc]
name = Sample metadata does not depend on instrument QC
type = forbidden
source_modules =
    xic_extractor.sample_metadata
forbidden_modules =
    xic_extractor.instrument_qc
allow_indirect_imports = False

[importlinter:contract:grouping-and-cell-consume-method-answers]
name = Shared grouping and cell closure do not select method interpreters
type = forbidden
source_modules =
    xic_extractor.alignment.grouping_rules
    xic_extractor.alignment.grouping_evidence
    xic_extractor.alignment.edge_scoring
    xic_extractor.alignment.feature_membership_inference
    xic_extractor.alignment.cross_sample.peak_groups
    xic_extractor.alignment.cross_sample.neighborhood_graph
    xic_extractor.alignment.cell_observation.observations
    xic_extractor.alignment.cell_observation.method_evidence
forbidden_modules =
    xic_extractor.alignment.cid_nl_grouping
    xic_extractor.alignment.cell_observation.cid_nl_evidence
    xic_extractor.alignment.backfill.cid_nl_evidence
# Existing CID-NL record admission binds interpreters; shared algorithms do not.
allow_indirect_imports = True
