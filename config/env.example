# XIC Extractor local machine paths.
# Copy this to an ignored .env or .env.xic-local and fill values for the machine
# that can run Thermo RAW validation. Do not commit real local paths.

XIC_REPO_ROOT=<absolute-path-to-xic-extractor-root>
XIC_RAW_ROOT=<absolute-path-to-85raw-tissue-root>
XIC_RAW_VALIDATION_DIR=<absolute-path-to-8raw-validation-subset>
# RawFileReader 8.0.42 + .NET 8 or later; not the older Xcalibur DLL folder.
# Use the path printed by xic-install-thermo-reader --accept-thermo-license.
THERMO_RAWFILE_READER_DLL_DIR=<absolute-path-to-installed-rawfilereader-8.0.42-folder>
XIC_ACQUISITION_CACHE_DIR=<absolute-path-on-a-fast-local-disk>
XIC_MANUAL_2RAW_ROOT=<absolute-path-to-manual-2raw-truth-data>
