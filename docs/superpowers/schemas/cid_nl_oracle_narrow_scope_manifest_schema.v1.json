{
  "schema_version": "cid_nl_oracle_narrow_scope_manifest_schema_v1",
  "manifest_schema_version": "cid_nl_oracle_narrow_scope_manifest_v1",
  "status": "active",
  "validation_status": "diagnostic_only",
  "purpose": "Freeze every candidate NARROW claim and its exact case membership before machine or holdout outcomes are revealed, so a narrower passing scope cannot be selected post hoc.",
  "row_unit": "one preregistered candidate claim scope",
  "required_columns": [
    "schema_version",
    "narrow_scope_manifest_id",
    "narrow_scope_id",
    "scope_precedence",
    "claim_label",
    "membership_predicate",
    "scope_membership_manifest_id",
    "scope_membership_manifest_sha256",
    "source_universe",
    "workflow_policy",
    "method_scope",
    "included_sampling_strata",
    "excluded_sampling_strata",
    "required_gate_ids",
    "allowed_overall_failed_gate_ids",
    "minimum_independent_units_parameter",
    "gatekeeping_rule_id",
    "membership_frozen_before_reveal",
    "machine_mapping_visible_at_seal",
    "source_row_sha256"
  ],
  "seal_required_fields": [
    "schema_version",
    "narrow_scope_manifest_id",
    "narrow_scope_tsv_sha256",
    "scope_membership_bundle_sha256",
    "scope_count",
    "all_membership_manifests_present",
    "all_scope_gate_sets_resolvable",
    "machine_mapping_revealed",
    "holdout_labels_revealed",
    "sealed_at_utc",
    "sealed_by",
    "seal_status",
    "supersedes_narrow_scope_manifest_id"
  ],
  "seal_expected_values": {
    "all_membership_manifests_present": true,
    "all_scope_gate_sets_resolvable": true,
    "machine_mapping_revealed": false,
    "holdout_labels_revealed": false
  },
  "integrity_rules": {
    "primary_key": [
      "narrow_scope_manifest_id",
      "narrow_scope_id"
    ],
    "scope_precedence_is_unique_positive_integer": true,
    "membership_predicate_and_exact_membership_hash_required": true,
    "source_row_sha256_is_canonical_row_digest_excluding_itself": true,
    "membership_frozen_before_machine_and_holdout_reveal": true,
    "required_gate_ids_must_resolve_in_frozen_gate_table": true,
    "allowed_overall_failed_gate_ids_must_be_explicit": true,
    "narrow_scope_pass_is_derived_from_raw_gate_results": true,
    "empty_or_post_reveal_scope_forbidden": true,
    "no_passing_preregistered_scope_means_nonhard_failure_redraw": true
  },
  "authority_rules": {
    "narrow_scope_grants_matrix_authority": false,
    "narrow_scope_grants_backfill_writer_authority": false,
    "narrow_scope_grants_counted_detection_authority": false,
    "narrow_scope_grants_selected_area_authority": false,
    "narrow_scope_grants_activation_or_export_authority": false
  }
}
