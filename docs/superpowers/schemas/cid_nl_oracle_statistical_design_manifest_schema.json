{
  "schema_version": "cid_nl_oracle_statistical_design_manifest_schema",
  "manifest_schema_version": "cid_nl_oracle_statistical_design_manifest",
  "status": "active",
  "validation_status": "diagnostic_only",
  "purpose": "Freeze each CID-NL oracle estimand, sampling design, uncertainty route, decision parameter, and planning inputs before formal holdout labels or machine mappings are opened.",
  "row_unit": "one preregistered estimand and gate parameter",
  "required_columns": [
    "schema_version",
    "statistical_design_manifest_id",
    "estimand_id",
    "gate_id",
    "claim_label",
    "target_population",
    "method_scope",
    "workflow_policy",
    "evaluation_unit",
    "success_event",
    "frame_id",
    "frame_completeness",
    "sampling_design_type",
    "point_estimator",
    "uncertainty_method",
    "confidence_sidedness",
    "confidence_level",
    "threshold_parameter_id",
    "threshold_value",
    "comparator",
    "planning_method",
    "design_value",
    "power",
    "target_interval_width",
    "minimum_independent_unit_count",
    "primary_cluster_key",
    "secondary_grouping_keys",
    "stratum_weight_rule",
    "machine_hold_handling",
    "human_unassessable_handling",
    "adaptive_supplemental_handling",
    "hidden_duplicate_handling",
    "incomplete_frame_claim_downgrade",
    "maximum_review_budget",
    "parameter_source",
    "frozen_before_reveal",
    "source_row_sha256"
  ],
  "allowed_sampling_design_types": [
    "finite_census",
    "independent_equal_probability_sample",
    "stratified_probability_sample",
    "clustered_probability_sample",
    "nonprobability_challenge",
    "incomplete_reference_frame"
  ],
  "allowed_uncertainty_methods": [
    "finite_census_descriptive",
    "wilson_score",
    "clopper_pearson_exact",
    "design_based_ratio_variance",
    "design_preserving_cluster_resampling",
    "descriptive_challenge_only",
    "partial_identification_bounds"
  ],
  "allowed_confidence_sidedness": [
    "one_sided_lower",
    "one_sided_upper",
    "two_sided",
    "not_applicable"
  ],
  "conditional_rules": {
    "finite_census_requires_descriptive_uncertainty_for_same_frame": true,
    "independent_equal_probability_sample_allows_wilson_or_exact": true,
    "stratified_or_clustered_sample_requires_design_aware_uncertainty": true,
    "nonprobability_challenge_requires_descriptive_only_claim": true,
    "incomplete_reference_frame_requires_partial_bounds_or_known_reference_claim": true,
    "confidence_level_required_when_uncertainty_method_uses_confidence_bounds": true,
    "confidence_bound_methods_require_finite_open_interval_level_and_compatible_sidedness": true,
    "threshold_value_and_parameter_source_required_before_formal_holdout": true,
    "hidden_duplicates_excluded_from_scientific_denominators": true,
    "adaptive_supplemental_excluded_from_representative_estimands": true,
    "machine_hold_remains_in_unconditional_recovery_denominator": true,
    "human_unassessable_reported_separately": true,
    "frozen_before_reveal_must_be_true": true
  },
  "seal_required_fields": [
    "schema_version",
    "statistical_design_manifest_id",
    "statistical_design_tsv_sha256",
    "sampling_manifest_schema_sha256",
    "reference_universe_schema_sha256",
    "gate_table_sha256",
    "estimand_count",
    "all_required_gate_parameters_resolved",
    "all_uncertainty_routes_resolved",
    "all_group_keys_resolved",
    "machine_mapping_revealed",
    "holdout_labels_revealed",
    "sealed_at_utc",
    "sealed_by",
    "seal_status",
    "supersedes_statistical_design_manifest_id"
  ],
  "seal_expected_values": {
    "all_required_gate_parameters_resolved": true,
    "all_uncertainty_routes_resolved": true,
    "all_group_keys_resolved": true,
    "machine_mapping_revealed": false,
    "holdout_labels_revealed": false
  },
  "integrity_rules": {
    "primary_key": [
      "statistical_design_manifest_id",
      "estimand_id",
      "gate_id"
    ],
    "one_uncertainty_route_per_estimand": true,
    "all_gate_parameters_resolved_before_formal_holdout": true,
    "sampling_design_matches_sampling_manifest_rows": true,
    "group_keys_resolve_to_sampling_manifest_columns": true,
    "post_reveal_parameter_or_method_change_forbidden": true,
    "post_reveal_change_requires_new_packet_and_supersession_edge": true
  },
  "authority_rules": {
    "statistical_design_grants_matrix_authority": false,
    "statistical_design_grants_backfill_writer_authority": false,
    "statistical_design_grants_counted_detection_authority": false,
    "statistical_design_grants_selected_area_authority": false,
    "statistical_design_grants_activation_or_export_authority": false
  }
}
