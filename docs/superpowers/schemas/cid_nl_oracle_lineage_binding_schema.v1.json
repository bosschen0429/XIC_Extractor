  "integrity_rules": {
    "primary_key": [
      "oracle_packet_id",
      "binding_id"
    ],
    "one_immutable_artifact_binding_per_row": true,
    "processing_attempt_references_exactly_one_request": true,
    "kernel_object_ref_is_processing_request_namespaced": true,
    "artifact_identity_requires_attempt_role_schema_and_digest": true,
    "review_binding_requires_stable_record_schema_digest_and_artifact_links": true,
    "gate_result_binding_requires_gate_table_input_artifacts_status_observed_threshold_and_verdict_dependency": true,
    "case_id_is_locator_not_lineage_identity": true,
    "path_display_name_timestamp_and_row_order_forbidden_as_identity": true,
    "missing_source_bytes_recorded_not_replayable": true,
    "historical_provenance_must_not_be_invented": true,
    "sealed_rows_are_append_only": true,
    "correction_requires_new_binding_and_supersession_edge": true,
    "missing_required_binding_verdict": "inconclusive"
  },
  "authority_rules": {
    "lineage_binding_grants_review_truth": false,
    "lineage_binding_grants_matrix_authority": false,
    "lineage_binding_grants_backfill_writer_authority": false,
    "lineage_binding_grants_counted_detection_authority": false,
    "lineage_binding_grants_selected_area_authority": false,
    "lineage_binding_grants_activation_or_export_authority": false
  }
