{
  "schema_version": "cid_nl_tested_tracer_proposal_manifest_schema",
  "manifest_schema_version": "cid_nl_tested_tracer_proposal_manifest",
  "status": "active",
  "validation_status": "diagnostic_only",
  "purpose": "Freeze every candidate emitted by one specific CID-NL/NL116 tracer attempt and its Targeted/Untargeted decision before formal holdout review. This manifest supplies the proposal-conditioned denominator but grants no product authority.",
  "row_unit": "one PeakHypothesis x AcquisitionSource x workflow_policy",
  "required_columns": [
    "schema_version",
    "proposal_manifest_id",
    "proposal_row_id",
    "processing_request_id",
    "processing_attempt_id",
    "acquisition_source_id",
    "sample_key",
    "tracer_id",
    "tracer_version",
    "tracer_config_sha256",
    "kernel_object_ref",
    "peak_hypothesis_id",
    "hypothesis_identity_sha256",
    "workflow_policy",
    "precursor_mz",
    "neutral_loss_da",
    "reference_rt_min",
    "observation_state",
    "observation_origin",
    "selection_state",
    "projection_outcome",
    "candidate_apex_rt_min",
    "candidate_left_rt_min",
    "candidate_right_rt_min",
    "candidate_area",
    "evidence_artifact_ids",
    "source_row_sha256"
  ],
  "allowed_workflow_policies": [
    "targeted",
    "untargeted"
  ],
  "allowed_observation_states": [
    "observed",
    "missing",
    "absent",
    "unassessable",
    "ambiguous",
    "failed"
  ],
  "allowed_observation_origins": [
    "discovery",
    "alignment",
    "backfill"
  ],
  "allowed_selection_states": [
    "selected",
    "not_selected",
    "no_selection"
  ],
  "allowed_projection_outcomes": [
    "select_value",
    "leave_missing",
    "hold"
  ],
  "nullable_columns": [
    "reference_rt_min",
    "candidate_apex_rt_min",
    "candidate_left_rt_min",
    "candidate_right_rt_min",
    "candidate_area"
  ],
  "conditional_rules": {
    "select_value_requires_observed_state": true,
    "select_value_requires_selected_state": true,
    "select_value_requires_apex_boundaries_and_area": true,
    "leave_missing_requires_absent_state": true,
    "leave_missing_requires_no_selection": true,
    "missing_unassessable_ambiguous_and_failed_require_hold": true,
    "absent_requires_leave_missing": true,
    "non_observed_state_forbids_selected_state": true,
    "observed_without_eligible_selection_requires_hold": true,
    "selected_apex_must_be_inside_boundaries": true,
    "selected_area_must_be_finite_and_non_negative": true,
    "non_selected_candidate_metrics_may_remain_available_for_audit": true,
    "blank_candidate_metrics_do_not_remove_the_row_from_candidate_universe": true
  },
  "seal_required_fields": [
    "schema_version",
    "proposal_manifest_id",
    "proposal_tsv_sha256",
    "processing_request_id",
    "processing_attempt_id",
    "tracer_id",
    "tracer_version",
    "tracer_config_sha256",
    "row_count",
    "distinct_peak_hypothesis_count",
    "distinct_acquisition_source_count",
    "precision_denominator_rule_id",
    "candidate_universe_complete",
    "machine_mapping_revealed_to_reviewer",
    "legacy_mapping_revealed_to_reviewer",
    "sealed_at_utc",
    "sealed_by",
    "seal_status",
    "supersedes_manifest_id"
  ],
  "seal_expected_values": {
    "candidate_universe_complete": true,
    "machine_mapping_revealed_to_reviewer": false,
    "legacy_mapping_revealed_to_reviewer": false
  },
  "precision_denominator_rules": {
    "rule_id": "cid_nl_tested_tracer_select_value",
    "sample_policy_unit": "Count unique proposal rows whose projection_outcome is select_value, grouped by workflow_policy.",
    "identity_family_unit": "Count unique kernel_object_ref values having at least one select_value row, grouped by workflow_policy.",
    "hold_and_leave_missing_are_not_positive_proposals": true,
    "reference_recovery_uses_this_manifest": false,
    "reference_recovery_owner": "independent formal-holdout reference universe"
  },
  "integrity_rules": {
    "primary_key": [
      "proposal_manifest_id",
      "proposal_row_id"
    ],
    "scientific_row_key": [
      "processing_request_id",
      "kernel_object_ref",
      "acquisition_source_id",
      "workflow_policy"
    ],
    "one_processing_request_per_manifest": true,
    "one_processing_attempt_per_manifest": true,
    "one_tracer_version_and_config_per_manifest": true,
    "all_emitted_candidates_included_before_denominator_filtering": true,
    "source_row_sha256_is_canonical_row_digest_excluding_itself": true,
    "legacy_or_placeholder_rows_forbidden": true,
    "candidate_universe_complete_required": true,
    "seal_before_formal_holdout_labels_open": true,
    "seal_before_machine_or_legacy_mapping_reveal_to_reviewer": true,
    "sealed_rows_are_append_only": true,
    "correction_requires_new_manifest_and_supersession_edge": true,
    "missing_or_invalid_seal_verdict": "inconclusive"
  },
  "authority_rules": {
    "matrix_authority": false,
    "backfill_writer_authority": false,
    "counted_detection_authority": false,
    "selected_area_authority": false,
    "workbook_or_gui_authority": false,
    "activation_or_export_authority": false,
    "product_writer_consumption": "forbidden_without_separate_activation_export_contract"
  }
}
