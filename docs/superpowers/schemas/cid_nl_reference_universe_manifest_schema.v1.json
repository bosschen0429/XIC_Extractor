{
  "schema_version": "cid_nl_reference_universe_manifest_schema_v1",
  "manifest_schema_version": "cid_nl_reference_universe_manifest_v1",
  "status": "active",
  "validation_status": "diagnostic_only",
  "purpose": "Freeze an independent, bounded CID-NL reference universe that can measure recovery without allowing tested-tracer proposals, legacy calls, or spectral-library membership to define sample-local presence.",
  "row_unit": "one reference claim for one PeakHypothesis-family x AcquisitionSource x method scope",
  "required_columns": [
