{
  "schema_version": "cid_nl_formal_holdout_sampling_manifest_schema",
  "manifest_schema_version": "cid_nl_formal_holdout_sampling_manifest",
  "status": "active",
  "validation_status": "diagnostic_only",
  "purpose": "Freeze the formal CID-NL/NL116 challenge, representative, duplicate, and supplemental case assignments before review while keeping source roles and machine mappings hidden from the domain reviewer.",
  "row_unit": "one blinded presentation of one underlying holdout case",
  "required_columns": [
    "schema_version",
    "holdout_manifest_id",
    "case_id",
    "presentation_id",
    "case_role",
    "analysis_role",
    "primary_presentation",
    "duplicate_of_case_id",
    "source_universe",
    "machine_conditioned_source",
    "estimand_id",
    "sampling_design_type",
    "sampling_frame_id",
    "sampling_frame_size",
    "sampling_stratum",
    "stratum_frame_size",
    "inclusion_probability",
    "analysis_weight",
    "independent_hypothesis_group_id",
    "family_group_id",
    "batch_group_id",
    "study_group_id",
    "instrument_group_id",
    "dependency_group_ids",
    "acquisition_source_id",
    "sample_key",
    "sample_material_stratum",
    "method_scope",
    "reference_source_type",
    "reference_claim_scope",
    "precursor_mz",
    "neutral_loss_da",
    "search_rt_start_min",
    "search_rt_end_min",
    "evidence_scope",
    "case_evidence_artifact_ids",
    "case_locator_sha256",
    "review_order",
    "source_role_hidden_from_reviewer",
    "machine_mapping_hidden_from_reviewer",
    "legacy_mapping_hidden_from_reviewer"
  ],
  "allowed_case_roles": [
    "challenge",
    "random_representative",
    "hidden_duplicate",
    "adaptive_supplemental"
  ],
  "allowed_analysis_roles": [
    "primary_confirmatory",
    "repeatability_only",
    "supplemental_descriptive"
  ],
  "allowed_source_universes": [
    "tested_tracer_proposal",
    "independent_reference",
    "matched_negative",
    "contract_challenge"
  ],
  "allowed_sampling_design_types": [
    "finite_census",
    "independent_equal_probability_sample",
    "stratified_probability_sample",
    "clustered_probability_sample",
    "incomplete_reference_frame",
    "nonprobability_challenge"
  ],
  "allowed_sample_material_strata": [
    "dna_only_biological",
    "dna_and_rna_mixed_biological",
    "pooled_qc",
    "not_applicable"
  ],
  "nullable_columns": [
    "duplicate_of_case_id",
    "inclusion_probability",
    "analysis_weight",
    "reference_source_type",
    "reference_claim_scope"
  ],
  "conditional_rules": {
    "hidden_duplicate_requires_duplicate_of_case_id": true,
    "hidden_duplicate_requires_repeatability_only_analysis_role": true,
    "hidden_duplicate_cannot_be_primary_presentation": true,
    "primary_presentation_cannot_be_repeatability_only": true,
    "hidden_duplicate_reuses_underlying_case_scientific_locator": true,
    "non_duplicate_requires_blank_duplicate_of_case_id": true,
    "random_representative_primary_requires_positive_inclusion_probability": true,
    "random_representative_primary_requires_positive_analysis_weight": true,
    "finite_census_requires_inclusion_probability_and_analysis_weight_equal_one": true,
    "probability_sample_requires_zero_less_than_inclusion_probability_at_most_one": true,
    "probability_sample_requires_analysis_weight_equal_inverse_inclusion_probability": true,
    "nonprobability_challenge_cannot_enter_representative_metric_denominators": true,
    "sampling_frame_and_stratum_frame_sizes_must_be_positive_and_consistent": true,
    "all_dependency_group_keys_required": true,
    "adaptive_supplemental_requires_supplemental_descriptive_analysis_role": true,
    "challenge_sampling_probability_may_be_blank": true,
    "independent_reference_requires_reference_source_type_and_claim_scope": true,
    "tested_tracer_proposal_forbids_reference_claim_fields": true,
    "matched_negative_requires_reference_claim_scope": true,
    "source_and_machine_mapping_hidden_flags_must_be_true_at_seal": true
  },
  "seal_required_fields": [
    "schema_version",
    "holdout_manifest_id",
    "holdout_tsv_sha256",
    "proposal_manifest_seal_id",
    "reference_universe_sha256",
    "statistical_design_manifest_sha256",
    "dependency_group_manifest_sha256",
    "narrow_scope_manifest_sha256",
    "sampling_algorithm",
    "sampling_seed_commitment",
    "primary_case_count",
    "challenge_case_count",
    "random_representative_case_count",
    "hidden_duplicate_presentation_count",
    "adaptive_supplemental_cap",
    "case_counts_and_staged_limits_frozen",
    "oracle_owner",
    "holdout_custodian",
    "domain_reviewer",
    "packet_producer",
    "gate_runner",
    "source_roles_revealed_to_reviewer",
    "machine_mapping_revealed_to_reviewer",
    "legacy_mapping_revealed_to_reviewer",
    "sealed_at_utc",
    "sealed_by",
    "seal_status",
    "supersedes_manifest_id"
  ],
  "seal_expected_values": {
    "case_counts_and_staged_limits_frozen": true,
    "source_roles_revealed_to_reviewer": false,
    "machine_mapping_revealed_to_reviewer": false,
    "legacy_mapping_revealed_to_reviewer": false
  },
  "analysis_rules": {
    "case_id_is_primary_analysis_unit": true,
    "exactly_one_primary_presentation_per_case": true,
    "hidden_duplicates_enter_confirmatory_denominators": false,
    "hidden_duplicates_measure_repeatability_only": true,
    "adaptive_supplemental_enters_representative_denominators": false,
    "sampled_representative_rows_require_inclusion_probability_and_weight": true,
    "uncertainty_dispatch_uses_sampling_design_type_and_dependency_group_keys": true,
    "proposal_precision_uses_proposal_universe": true,
    "reference_recovery_uses_independent_reference_universe": true,
    "proposal_universe_cannot_define_reference_recovery_denominator": true
  },
  "integrity_rules": {
    "primary_key": [
      "holdout_manifest_id",
      "presentation_id"
    ],
    "case_locator_is_not_lineage_identity": true,
    "stable_sample_and_acquisition_identities_required": true,
    "source_role_hidden_from_domain_reviewer_until_label_seal": true,
    "machine_and_legacy_mappings_hidden_until_label_seal": true,
    "case_counts_and_staged_limits_frozen_before_review": true,
    "sealed_rows_are_append_only": true,
    "post_reveal_case_removal_forbidden": true,
    "corruption_discovered_after_reveal_verdict": "inconclusive",
    "correction_requires_new_manifest_and_supersession_edge": true
  },
  "authority_rules": {
    "matrix_authority": false,
    "backfill_writer_authority": false,
    "counted_detection_authority": false,
    "selected_area_authority": false,
    "workbook_or_gui_authority": false,
    "activation_or_export_authority": false
  }
}
