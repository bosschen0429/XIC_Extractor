{
  "schema_version": "quantitative_projection_authority_manifest_schema_v1",
  "manifest_schema_version": "quantitative_projection_authority_manifest_v1",
  "purpose": "Machine-checkable contract for one dependent quantitative effect that may reproject an existing authorized Matrix value without gaining ProductWriter scope, new-write, selected-peak, or counted-detection authority.",
  "required_fields": [
    "schema_version",
    "effect_id",
    "status",
    "package_authority_artifact",
    "package_authority_sha256",
    "allowed_registered_writer_scope_ids",
    "activation_summary_artifact",
    "activation_summary_sha256",
    "current_effect_cell_count",
    "manifest_content_id"
  ],
  "allowed_statuses": [
    "HOLD_PENDING_VALIDATION",
    "ACTIVE"
  ],
  "authority_rules": {
    "effect_id": "untargeted_owner_backfill_canonical_quantitative_projection_v1",
    "package_authority_artifact": "xic_extractor/alignment/data/issue256_quantitative_projection_authority_v1.json",
    "package_authority_sha256_format": "lowercase_sha256_of_raw_canonical_package_bytes",
    "allowed_registered_writer_scope_ids": [
      "backfill_policy_write_ready_rows",
      "cid_nl_adopt_ready_feature_inclusion_95_cells",
      "backfill_expansion_clean_target_selective_activation_84_cells"
    ],
    "hold_activation_summary_artifact": "",
    "hold_activation_summary_sha256": "",
    "hold_current_effect_cell_count": 0,
    "active_activation_summary_artifact": "docs/superpowers/validation/issue256_untargeted_owner_backfill_canonical_quantitative_activation_v1/activation_summary.json",
    "active_activation_summary_sha256_format": "lowercase_sha256_of_raw_canonical_activation_summary_bytes",
    "active_current_effect_cell_count_rule": "positive_integer_equal_to_activation_summary_quantitative_effect_cell_count",
    "manifest_content_id_prefix": "quantitative-projection-authority-manifest.v1:",
    "manifest_content_id_basis": "sha256_over_preceding_fields_in_required_field_order_using_compact_ordered_json_without_trailing_lf",
    "file_encoding": "utf-8",
    "line_ending": "lf",
    "trailing_line_feed_count": 1,
    "grants_product_writer_scope": false,
    "active_transition_requires_refreeze": true
  }
}
