  "cards": [
    {
      "title": "這是責任關係，不是單一 supervisor 的時序",
      "items": [
        "Foreground acquisition、科學組合與發布不全由同一 runtime receipt 覆蓋；不同路徑保留其正式交接。"
      ],
      "dot": "cyan"
    },
    {
      "title": "Runtime 不挑選峰或格值",
      "items": [
        "執行 owner 管排程與資源，不取得科學判斷、writer 或產品化權限。"
      ],
      "dot": "amber"
    },
    {
      "title": "可讀曲線，不代表能改結果",
      "items": [
        "Inspector 讀保存證據；工作區取得的新診斷曲線不替換原本的峰、積分或 Matrix。"
      ],
      "dot": "cyan"
    }
